+// Called when a daemon exhausts its restart budget and stays down for good. The server
+// and its health probes keep running regardless, so report via console.error, which
+// does not depend on the DEBUG namespaces.
+ChildProcessService.globalHooks.onStartFailure = (service, attempts) => {
+  console.error(
+    `Service ${service.constructor.name} gave up after ${attempts} failed restarts. ` +
+      'It will not be restarted; the server continues in a degraded state.',
+  );
+
+  // Off by default: a host with UDP 5353 already bound would crash-loop the whole
+  // server instead of running without mDNS.
+  if (config.HOMEY_EXIT_ON_SERVICE_FAILURE === true) {
+    console.error('HOMEY_EXIT_ON_SERVICE_FAILURE=1 -- exiting so the restart policy can recover.');
+    process.exit(1);
+  }
+};
