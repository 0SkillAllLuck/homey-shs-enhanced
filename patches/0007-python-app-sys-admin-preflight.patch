+  /**
+   * Whether this process holds CAP_SYS_ADMIN (capability bit 21).
+   * Fails open: an unreadable or unparseable /proc/self/status returns true, so a working
+   * setup can never be blocked by this check. CapEff is a 64-bit mask, hence BigInt.
+   */
+  static async hasCapSysAdmin() {
+    try {
+      const status = await fs.promises.readFile('/proc/self/status', 'utf8');
+      const match = status.match(/^CapEff:\s*([0-9a-fA-F]+)$/m);
+
+      if (match == null) return true;
+
+      return ((BigInt(`0x${match[1]}`) >> 21n) & 1n) === 1n;
+    } catch {
+      return true;
+    }
